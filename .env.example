# Copy to .env on the server. Read by docker compose (and by `npm start` if you export them).

# Name and five-letter PIN of the organization created on first start.
# The PIN is hashed and never stored in plain text; this variable is only read
# while data/orgs.json does not exist yet.
DEFAULT_ORG_NAME=Summerfield Ward
DEFAULT_ORG_PIN=ABCDE

# Optional. If unset, a random secret is generated once and kept in data/jwt-secret.
#JWT_SECRET=

# Optional. How long a PIN entry stays valid on a device (default 30).
#TOKEN_TTL_DAYS=30
